# Without Supabase credentials, development automatically uses an isolated local demo.
# Demo never charges cards and is not durable production storage.
ALLOW_DEMO=false
# Canonical origin, required in production; must match your browser URL for CSRF checks.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy service_role key is also supported for existing installations.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Up to two decimal places. Rounded to nearest cent using integer arithmetic.
PLATFORM_FEE_PERCENT=8
# Optional country for Express accounts. Leave blank to let Stripe onboarding select it.
STRIPE_CONNECT_COUNTRY=
# Used only by npm run seed; choose a real non-production email and a strong password.
SEED_EMAIL=producer@example.com
SEED_PASSWORD=

# Transactional purchase receipts. Verify the sender's domain in Resend.
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=
# Optional dedicated encryption secret; otherwise the server service-role key is used.
# Keep this stable so queued private receipt links remain decryptable.
EMAIL_ENCRYPTION_KEY=
# Authorizes GET /api/jobs/receipts from your deployment scheduler.
CRON_SECRET=
