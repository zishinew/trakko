      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Neutral sidebar with a clear current page.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Producer workspace\"><a href=\"#overview\" aria-current=\"page\">Overview</a><a href=\"#beats\">Beats</a><a href=\"#orders\">Orders</a></nav>",
      "css": ".ds-nav{background:#f2f2f5;padding:24px 16px;width:236px;font-family:var(--font-body,Inter),sans-serif;}.ds-nav a{display:flex;gap:13px;padding:11px 12px;min-height:43px;font-size:13px;font-weight:550;line-height:1.5;border-radius:9px;color:var(--muted,#63636f);text-decoration:none;transition:background-color 150ms ease,color 150ms ease}.ds-nav a[aria-current]{background:var(--ink,#202024);color:#fff}.ds-nav a:focus-visible{outline:2px solid var(--accent,#626270);outline-offset:4px}@media(hover:hover) and (pointer:fine){.ds-nav a:hover{background:#e6e6ec;color:var(--ink,#202024)}.ds-nav a[aria-current]:hover{background:#323238;color:#fff}}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none}}"
    },
