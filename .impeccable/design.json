      "refersTo": "input",
      "description": "Explicit label and native field.",
      "html": "<label class=\"ds-field\" for=\"ds-title\">Beat title<input id=\"ds-title\" class=\"ds-input\" placeholder=\"Name your release\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;font-family:var(--font-body,Inter),sans-serif;color:var(--text,#202024);font-size:13px;font-weight:600}.ds-input{width:100%;background:var(--surface,#fff);border:1px solid var(--line,#e2e2e8);border-radius:7px;padding:12px 14px;min-height:44px;font-family:var(--font-body,Inter),sans-serif;font-size:14px;line-height:1.5;font-weight:400;color:var(--text,#202024);transition:border-color 150ms ease,box-shadow 150ms ease}.ds-input::placeholder{color:var(--muted,#63636f)}.ds-input:focus-visible{outline:2px solid var(--accent,#626270);outline-offset:1px}@media(pointer:coarse){.ds-input{font-size:16px}}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}"
    },
    {
