  "narrative": {
    "northStar": "Daylight notebook",
    "overview": "Trakko feels like a generous daylight studio: pale sky surrounds paper surfaces, near-black type sets the hierarchy, and charcoal pill actions give the interface a clear point of emphasis. Medium-weight, regular-width Inter connects expressive marketing with practical producer tools. Soft lavender, peach, and powder-blue washes add warmth without competing with music.\n\nThe user-supplied Geniestudio reference governs this system across marketing, dashboard, authentication, and the default light storefront. Trakko adapts it with locally served Inter in place of Aeonik/Geist, an interactive paper-stack listening room, real playable demo releases, and lavender/peach/powder-blue instead of mint. Producer-selected dark themes and custom accents retain their own surface and contrast tokens. The hero uses a code-native listening console with shared audio state, measured RMS waveforms, pointer depth, hover-fanned papers, and reduced-motion support. No AI-generated hero image remains.",
    "keyCharacteristics": [
      "Pale sky canvas and paper cards with tonal, mostly flat depth.",
      "Regular-width Inter at weight 500 for display and principal headings.",
      "Generous rounded cards, pill actions, and clearly labeled native fields.",
      "A functional listening room with measured audio waveforms, paper depth, and genuine release playback.",
      "Producer-owned storefront themes, readable task screens, and explicit demo states."
    ],
    "rules": [
      {
        "name": "The Surface Ownership Rule",
        "body": "Apply daylight to platform and default light surfaces; preserve producer-selected dark themes and custom accents through their scoped tokens.",
        "section": "colors"
      },
      {
        "name": "The Medium Voice Rule",
        "body": "Use locally served regular-width Inter at weight 500 for display and principal headings. Preserve compact label emphasis where the working UI uses it.",
        "section": "typography"
      },
      {
        "name": "The Paper Depth Rule",
        "body": "Separate content cards from the canvas with tone and rounded shape. Keep ordinary panels flat; use shadows only for controls, overlays, and the persistent player.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the sky canvas, paper cards, charcoal actions, and blue link/focus accents.",
      "Do use local Inter, with weight 500 and tight tracking for principal headings.",
      "Do preserve real artwork, actual preview controls, accurate prices, and one persistent player.",
      "Do keep keyboard focus, explicit field labels, native shelf scrolling, and reduced-motion behavior.",
      "Do retain producer-selected themes and accents.",
      "Do label demos and simulated purchases and state the 8% sales fee with separate processing charges.",
      "Do use code-native interactions and measured audio data; do not add AI-generated illustrations."
    ],
    "donts": [
      "Don\u2019t restore the charcoal marketing stage, background shader, or slanted browser-window hero.",
      "Don\u2019t restore green/mint branding or condensed display lettering.",
      "Don\u2019t use blue as the platform\u2019s primary button fill or gradients as large decorative surfaces.",
      "Don\u2019t add shadows to ordinary content cards or introduce sharp corners as the main shape language.",
      "Don\u2019t borrow customer claims, testimonials, adoption figures, or third-party illustration assets.",
      "Don\u2019t apply marketing headline choreography or oversized display type to producer task screens."
    ]
  }
