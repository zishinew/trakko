      "css": ".ds-panel{background:var(--surface,#fff);color:var(--text,#202024);border:1px solid var(--line,#e2e2e8);border-radius:12px;overflow:hidden;box-shadow:none;font-family:var(--font-body,Inter),sans-serif;}.ds-panel-heading{padding:20px 22px}.ds-panel h2{margin:0;font-size:18px;font-weight:600;line-height:1.15;letter-spacing:-.03em}.ds-panel p{margin:6px 0 0;font-size:12px;line-height:1.5;color:var(--muted,#63636f)}"
