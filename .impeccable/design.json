      "html": "<section class=\"ds-window\" aria-label=\"Demo storefront window\"><div class=\"ds-window-bar\"><span class=\"ds-window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span>/ziova</span><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6\"/></svg></div></section>",
      "css": ".ds-window{border:1px solid #ffffff24;border-radius:16px;overflow:hidden;background:#141416;color:#f4f4f5;box-shadow:0 28px 60px #0008;font-family:var(--font-body,Inter),sans-serif}.ds-window-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:38px;padding:0 15px;background:#1b1b1f;border-bottom:1px solid #ffffff10;color:#b2b2bd;font-size:10px}.ds-window-dots{display:flex;gap:5px}.ds-window-dots i{width:6px;height:6px;border-radius:50%;background:#65656f}"
    }
  ],
  "narrative": {
    "northStar": "Clean creator platform",
    "overview": "Trakko uses a quiet creator-platform identity: charcoal marketing surfaces, white actions, muted gray reading, and regular-width Inter throughout. Music supplies the visual character through actual release artwork and playable previews. The user-selected guns.lol reference informs compact navigation, centered introduction, and overlapping perspective windows in the homepage hero; the confirmed adaptation uses fewer colors and cleaner presentation.\n\nProducer workflows remain neutral and light, with direct controls, readable tables, and flat panels. Producer storefront themes and accents remain producer-owned. The earlier green Studio palette and condensed typography are superseded; atmosphere is now a subdued monochrome field behind marketing only.",
    "keyCharacteristics": [
      "Regular-width Inter for both display and working UI.",
      "Charcoal marketing and neutral light working screens.",
      "Actual release artwork, preview controls, and one persistent player.",
      "Restrained, pausable monochrome atmosphere with static fallback.",
      "Flat working panels, a perspective-window homepage showcase, and clear keyboard focus."
    ],
    "rules": [
      {
        "name": "The Surface Ownership Rule",
        "body": "Keep platform marketing monochrome and producer workflows neutral light; preserve producer-owned storefront theme and accent.",
        "section": "colors"
      },
      {
        "name": "The One Typeface Rule",
        "body": "Use regular-width Inter for both display and body. Do not restore condensed release lettering.",
        "section": "typography"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Keep working panels flat at rest. Reserve diffuse shadows for dialogs, authentication cards, the persistent player, and the homepage showcase windows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use regular-width Inter and the extracted neutral platform tokens.",
      "Do preserve real artwork, clear preview controls, and a single persistent player.",
      "Do keep visible keyboard focus, explicit status wording, and coarse-pointer input sizing.",
      "Do keep background atmosphere bounded, pausable, and readable with a static fallback.",
      "Do preserve the producer’s selected storefront theme and accent.",
      "Do label demo releases, simulated purchases, and illustrative figures clearly.",
      "Do preserve real playback and license links within the perspective hero, with immediate keyboard flattening and a static reduced-motion layout."
    ],
    "donts": [
      "Don’t restore green marketing fields or condensed typography.",
      "Don’t add oversized decorative footer lettering.",
      "Don’t introduce borrowed adoption claims, gun motifs, or third-party source-copy claims.",
      "Don’t apply background shaders or delayed headline choreography to producer task screens.",
      "Don’t freeze transient control feedback when the background is paused.",
      "Don’t promote remaining localized legacy accents into the new brand palette."
    ]
  }
}
