      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-family:var(--font-body,Inter),sans-serif;font-size:13px;font-weight:650;line-height:1.5;padding:11px 17px;min-height:44px;border:1px solid var(--line,#e2e2e8);border-radius:8px;cursor:pointer;transition:transform 120ms cubic-bezier(.23,1,.32,1),background-color 120ms ease,border-color 120ms ease}.ds-button:active{transform:scale(.97)}.ds-button:focus-visible{outline:2px solid var(--accent,#626270);outline-offset:4px}.ds-button:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-marketing-secondary{background:#18181c;color:#ececf0;border-color:#ffffff18;min-height:46px;padding:12px 20px;border-radius:10px}@media(hover:hover) and (pointer:fine){.ds-marketing-secondary:hover{background:#242429}}"
    },
    {
      "name": "Text Field",
